# ============================================
# E-COMMERCE API ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=mysql://user:password@localhost:3306/ecommerce

# Option 2: Use individual variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ecommerce

# ============================================
# JWT AUTHENTICATION
# ============================================
# ⚠️ IMPORTANT: Change this to a strong, random string in production!
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# REDIS CACHE (Optional - app works without it)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# EMAIL SERVICE (SMTP)
# ============================================
# Required for password reset and order confirmations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@ecommerce.com

# ============================================
# PAYMENT GATEWAYS
# ============================================

# VNPay Configuration
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_SECRET_KEY=your-vnpay-secret-key
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/callback

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# FILE UPLOAD
# ============================================
# Maximum file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# ============================================
# NOTES
# ============================================
# 1. For production, ensure all required variables are set
# 2. Use strong, random secrets for JWT_SECRET
# 3. Never commit .env file to version control
# 4. Redis is optional but recommended for better performance
# 5. Email service is required for password reset functionality

