# ============================================
# E-Commerce Web - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# API Configuration
# ============================================
# Backend API URL
# In development: Leave empty to use Vite proxy (recommended)
# In production: Set to your API domain (e.g., https://api.example.com)
# VITE_API_URL=/api

# ============================================
# Application Configuration
# ============================================
# Application mode: development, production, test
# This is usually set automatically by Vite based on npm run command
# MODE=development

# ============================================
# Optional: Feature Flags
# ============================================
# Enable/disable features (defaults are in src/config/index.ts)
# VITE_ENABLE_REVIEWS=true
# VITE_ENABLE_WISHLIST=true
# VITE_ENABLE_COUPONS=true

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# Add your analytics keys here when ready
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# ============================================
# Redis Configuration (Optional)
# ============================================
# Redis connection URL for caching
# Format: redis://[username]:[password]@[host]:[port]
# Example: redis://localhost:6379
# Leave empty to disable caching (app will still work)
REDIS_URL=redis://localhost:6379

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP settings for sending emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@ecommerce.com
# FRONTEND_URL=http://localhost:5173
